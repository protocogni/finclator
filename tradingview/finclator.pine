f_at(tArr, vArr, t) =>
    v = 0.0
    for i = 0 to array.size(tArr) - 1
        if t >= array.get(tArr, i)
            v := array.get(vArr, i)
    v

f_n(tArr, nArr, t) =>
    v = 0
    for i = 0 to array.size(tArr) - 1
        if t >= array.get(tArr, i)
            v := array.get(nArr, i)
    v

