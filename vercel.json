{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/panel.py": { "memory": 1024, "maxDuration": 60 },
    "api/auth.js": { "maxDuration": 15 }
  },
  "crons": [
    { "path": "/panel/report", "schedule": "30 12 * * *" }
  ],
  "rewrites": [
    { "source": "/panel", "destination": "/api/panel" },
    { "source": "/panel/(.*)", "destination": "/api/panel?p=$1" },
    { "source": "/auth/(.*)", "destination": "/api/auth?action=$1" },
    { "source": "/method", "destination": "/method.html" },
    { "source": "/login", "destination": "/login.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
    ] },
    { "source": "/fonts/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/panel(.*)", "headers": [ { "key": "Cache-Control", "value": "private, no-store" }, { "key": "X-Robots-Tag", "value": "noindex" } ] }
  ]
}
